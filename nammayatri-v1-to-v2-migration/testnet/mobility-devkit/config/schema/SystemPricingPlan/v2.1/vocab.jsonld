{
  "@context": {
    "beckn": "https://schema.beckn.io/linked-data/latest-context.jsonld",
    "schema": "https://schema.org/version/latest/schemaorg-current-https.jsonld",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "beckn:SystemPricingPlan",
      "@type": "owl:Class",
      "rdfs:label": { "@value": "SystemPricingPlan", "@language": "en" },
      "rdfs:comment": { "@value": "A pricing plan defined by a shared mobility system. v2.1 adds the full V1 ONDC TRV10 FARE_POLICY tag group fields.", "@language": "en" },
      "rdfs:subClassOf": { "@id": "https://schema.org/PriceSpecification" }
    },
    {
      "@id": "beckn:cancellationCharges",
      "@type": "rdf:Property",
      "rdfs:label": { "@value": "cancellationCharges", "@language": "en" },
      "rdfs:comment": { "@value": "Fixed cancellation fee. Maps to V1 FARE_POLICY.CANCELLATION_CHARGES.", "@language": "en" },
      "rdfs:domain": { "@id": "beckn:SystemPricingPlan" },
      "rdfs:range": { "@id": "xsd:string" },
      "skos:closeMatch": { "@id": "https://schema.org/Text" }
    },
    {
      "@id": "beckn:baseFare",
      "@type": "rdf:Property",
      "rdfs:label": { "@value": "baseFare", "@language": "en" },
      "rdfs:comment": { "@value": "Fixed fare at trip start covering base distance. Maps to V1 FARE_POLICY.BASE_FARE.", "@language": "en" },
      "rdfs:domain": { "@id": "beckn:SystemPricingPlan" },
      "rdfs:range": { "@id": "xsd:string" },
      "skos:closeMatch": { "@id": "https://schema.org/Text" }
    },
    {
      "@id": "beckn:extraPerKmFare",
      "@type": "rdf:Property",
      "rdfs:label": { "@value": "extraPerKmFare", "@language": "en" },
      "rdfs:comment": { "@value": "Per-km rate beyond base distance. Maps to V1 FARE_POLICY.EXTRA_PER_KM_FARE.", "@language": "en" },
      "rdfs:domain": { "@id": "beckn:SystemPricingPlan" },
      "rdfs:range": { "@id": "xsd:string" },
      "skos:closeMatch": { "@id": "https://schema.org/Text" }
    },
    {
      "@id": "beckn:waitingChargePerMin",
      "@type": "rdf:Property",
      "rdfs:label": { "@value": "waitingChargePerMin", "@language": "en" },
      "rdfs:comment": { "@value": "Charge per minute waiting beyond free window. Maps to V1 FARE_POLICY.WAITING_CHARGE_PER_MIN.", "@language": "en" },
      "rdfs:domain": { "@id": "beckn:SystemPricingPlan" },
      "rdfs:range": { "@id": "xsd:string" },
      "skos:closeMatch": { "@id": "https://schema.org/Text" }
    },
    {
      "@id": "beckn:nightShiftCharge",
      "@type": "rdf:Property",
      "rdfs:label": { "@value": "nightShiftCharge", "@language": "en" },
      "rdfs:comment": { "@value": "Flat fee or multiplier during night shift. Maps to V1 FARE_POLICY.NIGHT_SHIFT_CHARGE.", "@language": "en" },
      "rdfs:domain": { "@id": "beckn:SystemPricingPlan" },
      "rdfs:range": { "@id": "xsd:string" },
      "skos:closeMatch": { "@id": "https://schema.org/Text" }
    }
  ]
}
