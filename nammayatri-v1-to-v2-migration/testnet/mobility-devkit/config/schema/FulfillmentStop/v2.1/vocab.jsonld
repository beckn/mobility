{
  "@context": {
    "beckn": "https://schema.beckn.io/linked-data/latest-context.jsonld",
    "schema": "https://schema.org/version/latest/schemaorg-current-https.jsonld",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "beckn:FulfillmentStop",
      "@type": "owl:Class",
      "rdfs:label": { "@value": "FulfillmentStop", "@language": "en" },
      "rdfs:comment": { "@value": "A specific location associated with a fulfillment at which passengers board, alight, or transfer. v2.1 adds parentStopId and authorization.", "@language": "en" },
      "rdfs:seeAlso": { "@id": "https://schema.org/DeliveryEvent" }
    },
    {
      "@id": "beckn:stopType",
      "@type": "rdf:Property",
      "rdfs:label": { "@value": "stopType", "@language": "en" },
      "rdfs:comment": { "@value": "Role of this stop in the fulfillment (START, END, INTERMEDIATE)", "@language": "en" },
      "rdfs:domain": { "@id": "beckn:FulfillmentStop" },
      "rdfs:range": { "@id": "xsd:string" },
      "skos:closeMatch": { "@id": "https://schema.org/Text" }
    },
    {
      "@id": "beckn:scheduledTime",
      "@type": "rdf:Property",
      "rdfs:label": { "@value": "scheduledTime", "@language": "en" },
      "rdfs:comment": { "@value": "Scheduled arrival or departure time at this stop", "@language": "en" },
      "rdfs:domain": { "@id": "beckn:FulfillmentStop" },
      "rdfs:range": { "@id": "xsd:dateTime" },
      "skos:closeMatch": { "@id": "https://schema.org/DateTime" }
    },
    {
      "@id": "beckn:actualTime",
      "@type": "rdf:Property",
      "rdfs:label": { "@value": "actualTime", "@language": "en" },
      "rdfs:comment": { "@value": "Actual arrival or departure time at this stop", "@language": "en" },
      "rdfs:domain": { "@id": "beckn:FulfillmentStop" },
      "rdfs:range": { "@id": "xsd:dateTime" },
      "skos:closeMatch": { "@id": "https://schema.org/DateTime" }
    },
    {
      "@id": "beckn:stopRef",
      "@type": "rdf:Property",
      "rdfs:label": { "@value": "stopRef", "@language": "en" },
      "rdfs:comment": { "@value": "Reference to the Stop entity for this fulfillment stop", "@language": "en" },
      "rdfs:domain": { "@id": "beckn:FulfillmentStop" },
      "rdfs:range": { "@id": "beckn:Stop" }
    },
    {
      "@id": "beckn:passengerCount",
      "@type": "rdf:Property",
      "rdfs:label": { "@value": "passengerCount", "@language": "en" },
      "rdfs:comment": { "@value": "Passenger count at this fulfillment stop", "@language": "en" },
      "rdfs:domain": { "@id": "beckn:FulfillmentStop" },
      "rdfs:range": { "@id": "beckn:PassengerCount" }
    },
    {
      "@id": "beckn:location",
      "@type": "rdf:Property",
      "rdfs:label": { "@value": "location", "@language": "en" },
      "rdfs:comment": { "@value": "Geographic location of the stop", "@language": "en" },
      "rdfs:domain": { "@id": "beckn:FulfillmentStop" },
      "rdfs:range": { "@id": "https://schema.beckn.io/core/v2.0/#Location" }
    },
    {
      "@id": "beckn:instructions",
      "@type": "rdf:Property",
      "rdfs:label": { "@value": "instructions", "@language": "en" },
      "rdfs:comment": { "@value": "Instructions for passengers at this stop", "@language": "en" },
      "rdfs:domain": { "@id": "beckn:FulfillmentStop" },
      "rdfs:range": { "@id": "https://schema.beckn.io/core/v2.0/#Descriptor" }
    },
    {
      "@id": "beckn:time",
      "@type": "rdf:Property",
      "rdfs:label": { "@value": "time", "@language": "en" },
      "rdfs:comment": { "@value": "Expected time window at this stop", "@language": "en" },
      "rdfs:domain": { "@id": "beckn:FulfillmentStop" },
      "rdfs:range": { "@id": "https://schema.beckn.io/core/v2.0/#TimePeriod" }
    },
    {
      "@id": "beckn:parentStopId",
      "@type": "rdf:Property",
      "rdfs:label": { "@value": "parentStopId", "@language": "en" },
      "rdfs:comment": { "@value": "ID of the parent stop. Maps to V1 stop.parent_stop_id.", "@language": "en" },
      "rdfs:domain": { "@id": "beckn:FulfillmentStop" },
      "rdfs:range": { "@id": "xsd:string" },
      "skos:closeMatch": { "@id": "https://schema.org/Text" }
    },
    {
      "@id": "beckn:authorization",
      "@type": "rdf:Property",
      "rdfs:label": { "@value": "authorization", "@language": "en" },
      "rdfs:comment": { "@value": "Authorization credential required at this stop (e.g. OTP). Maps to V1 stop.authorization.", "@language": "en" },
      "rdfs:domain": { "@id": "beckn:FulfillmentStop" },
      "rdfs:range": { "@id": "beckn:FulfillmentStageAuthorization" }
    }
  ]
}
